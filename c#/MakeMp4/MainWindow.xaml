<Window x:Class="MakeMp4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MakeMp4"
        mc:Ignorable="d"
        Title="MakeMp4 — 音频 + 图片 → mp4"
        Height="780" Width="1060" MinHeight="520" MinWidth="820"
        Icon="ico.ico"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,10,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#FF2B2B2B" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,3,6,3" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldButton" TargetType="Button">
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinWidth" Value="62" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF7A7A7A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3,6,3" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="240" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- ============ 配置 ============ -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 目录 -->
                <GroupBox Grid.Row="0" Grid.Column="0" Header="目录" Margin="0,0,6,6" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="音频目录" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="Audio" Style="{StaticResource FieldBox}" />
                        <Button Grid.Row="0" Grid.Column="2" Content="浏览…" Style="{StaticResource FieldButton}" Click="BrowseAudio_Click" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="图片目录" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="Images" Style="{StaticResource FieldBox}" />
                        <Button Grid.Row="1" Grid.Column="2" Content="浏览…" Style="{StaticResource FieldButton}" Click="BrowseImages_Click" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="输出目录" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="Out" Style="{StaticResource FieldBox}" />
                        <Button Grid.Row="2" Grid.Column="2" Content="浏览…" Style="{StaticResource FieldButton}" Click="BrowseOut_Click" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="配置文件" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="ConfigFile" Style="{StaticResource FieldBox}" IsReadOnly="True" />
                        <Button Grid.Row="3" Grid.Column="2" Content="载入…" Style="{StaticResource FieldButton}" Click="LoadIni_Click" />

                        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <TextBlock Text="留空时输出到「音频目录\out」" Style="{StaticResource Hint}" />
                            <Button Content="保存配置…" Margin="10,0,0,0" Padding="10,2" Click="SaveIni_Click" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- 封面 -->
                <GroupBox Grid.Row="0" Grid.Column="1" Header="片头封面" Margin="6,0,0,6" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="封面字体" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="Font" Style="{StaticResource FieldBox}" />
                        <Button Grid.Row="0" Grid.Column="2" Content="浏览…" Style="{StaticResource FieldButton}" Click="BrowseFont_Click" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="封面秒数" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="CoverSeconds" Style="{StaticResource FieldBox}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="0 = 不插封面" Style="{StaticResource Hint}" Margin="6,4,0,4" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="底色" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="CoverColor" Style="{StaticResource FieldBox}" />
                        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="歌名色" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TitleColor" Width="70" Style="{StaticResource FieldBox}" />
                            <TextBlock Text="作者色" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ArtistColor" Width="70" Style="{StaticResource FieldBox}" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="歌名字号" Style="{StaticResource FieldLabel}" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <TextBox x:Name="TitleSize" Width="60" Style="{StaticResource FieldBox}" />
                            <TextBlock Text="作者字号" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ArtistSize" Width="60" Style="{StaticResource FieldBox}" />
                            <TextBlock Text="留空 = 按视频高度自动" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="KeepCover" Content="保留生成的封面图（covers/）" Margin="0,6,0,0" />
                    </Grid>
                </GroupBox>

                <!-- 视频 -->
                <GroupBox Grid.Row="1" Grid.Column="0" Header="视频 / 编码" Margin="0,0,6,6" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="尺寸" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="SizeBox" Style="{StaticResource FieldBox}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="帧率" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="Fps" Width="56" Style="{StaticResource FieldBox}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="每图秒数" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="Seconds" Style="{StaticResource FieldBox}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="填充色" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="3" x:Name="PadColor" Width="80" Style="{StaticResource FieldBox}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="编码器" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="VCodec" Style="{StaticResource FieldBox}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="CRF" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="3" x:Name="Crf" Width="56" Style="{StaticResource FieldBox}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="preset" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="Preset" Style="{StaticResource FieldCombo}" IsEditable="True" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="音频码率" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="3" x:Name="ABitrate" Width="80" Style="{StaticResource FieldBox}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="图片自适应" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="FitMode" Style="{StaticResource FieldCombo}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4"
                                   Text="幻灯片全是静帧，ultrafast 编码快很多、画质几乎没区别；想要更小的文件改成 veryfast / medium。图片自适应：等比缩放补边（默认）；宽度自适应 = 高度铺满、多出的宽度居中裁掉；高度自适应 = 宽度铺满、多出的高度居中裁掉，不足处用填充色补边。"
                                   Style="{StaticResource Hint}" TextWrapping="Wrap" />
                    </Grid>
                </GroupBox>

                <!-- 开关 + 外部程序 -->
                <GroupBox Grid.Row="1" Grid.Column="1" Header="开关 / 外部程序" Margin="6,0,0,6" Padding="8">
                    <StackPanel>
                        <WrapPanel>
                            <CheckBox x:Name="Shuffle" Content="随机顺序" Margin="0,0,16,4" />
                            <CheckBox x:Name="Force" Content="强制重建" Margin="0,0,16,4" />
                            <CheckBox x:Name="VerifyCover" Content="校验空封面" Margin="0,0,16,4" />
                            <CheckBox x:Name="KeepTemp" Content="保留中间文件" Margin="0,0,16,4" />
                            <CheckBox x:Name="DryRun" Content="只打印命令（dry-run）" Margin="0,0,16,4" />
                        </WrapPanel>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ImageMagick 目录" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="MagickDir" Style="{StaticResource FieldBox}" />
                            <Button Grid.Row="0" Grid.Column="2" Content="浏览…" Style="{StaticResource FieldButton}" Click="BrowseMagick_Click" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ffmpeg 目录" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="FfmpegDir" Style="{StaticResource FieldBox}" />
                            <Button Grid.Row="1" Grid.Column="2" Content="浏览…" Style="{StaticResource FieldButton}" Click="BrowseFfmpeg_Click" />

                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                       Text="填 ImageMagick / ffmpeg 所在目录，程序使用目录里的 magick.exe、ffmpeg.exe、ffprobe.exe；留空则自动在 PATH 里查找。"
                                       Style="{StaticResource Hint}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 说明 -->
                <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Header="流程" Margin="0,0,0,6" Padding="8">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Hint}"
                                   Text="音频文件名格式：歌曲名-作者.mp3；图片文件名格式：Image00001.jpg（五位递增）。图片目录里也可以放视频片段（mp4/mov/mkv/webm/avi…），按自己的时长整段接入幻灯片、原声丢弃。" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Hint}"
                                   Text="封面用 ImageMagick 渲染成文字图：歌名与作者各一行居中，缓存到「输出目录\covers」，配色/排版相关配置变化后自动重建。幻灯片把抽到的每张图按设置的秒数、每个视频片段按自身时长各编成一小段，再拼成一条；成片把封面排在最前面、正片循环铺满音频时长（视频流直接 copy，不重新编码），封面只会出现在开头一次；循环剩下的零头用重新洗牌的图片收尾，成片不会拿片头去重复片尾。" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Hint}"
                                   Text="每次运行都会写「输出目录\make_mp4.log」，出错时把这份日志发出来就能看到卡在哪一步。" />
                    </StackPanel>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <!-- ============ 操作条 ============ -->
        <Grid Grid.Row="1" Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="StartButton" Content="开始生成" Padding="18,5" FontWeight="Bold" Click="Start_Click" />
            <Button Grid.Column="1" x:Name="CancelButton" Content="取消" Padding="14,5" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click" />
            <ProgressBar Grid.Column="2" x:Name="Progress" Height="18" Margin="12,0" Minimum="0" Maximum="1" />
            <TextBlock Grid.Column="3" x:Name="Status" VerticalAlignment="Center" Margin="0,0,10,0" Text="就绪" />
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button x:Name="OpenOutButton" Content="打开输出目录" Padding="10,4" Click="OpenOut_Click" />
                <Button Content="清空日志" Padding="10,4" Margin="8,0,0,0" Click="ClearLog_Click" />
                <CheckBox x:Name="AutoScroll" Content="自动滚动" IsChecked="True" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- ============ 日志 ============ -->
        <GroupBox Grid.Row="2" Header="运行日志" Padding="6">
            <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                     TextWrapping="NoWrap" />
        </GroupBox>
    </Grid>
</Window>
