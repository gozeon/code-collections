@page
@model Niffer.Pages.Admin.Subscriptions.CreateModel

@{
ViewData["Title"] = "Create";
}
        
<h1>Create</h1>
        
<h4>Subscription</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Subscription.Url" class="control-label"></label>
                <input asp-for="Subscription.Url" class="form-control" type="url"/>
                <span asp-validation-for="Subscription.Url" class="text-danger"></span>
            </div>
            <div class="form-group">
                <button type="submit" asp-page-handler="Append" class="btn btn-primary">
                    追加导入
                </button>
                <button type="submit" asp-page-handler="Overwrite" class="btn btn-danger"
                        onclick="return confirm('警告：直接导入(覆盖模式)将会清空之前的所有数据！确定继续吗？');">
                    覆盖导入 (清空旧数据)
                </button>
            </div>
        </form>
    </div>
</div>

<hr />
<div class="row">
    <div class="col-md-4">

        <form method="post" asp-page-handler="DirectImport">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label class="control-label fw-bold">请粘贴 Base64 字符串：</label>
                <!-- Textarea mapped using the custom name attribute -->
                <textarea name="RawBase64Input" class="form-control" rows="6" placeholder="请在这里粘贴完整的 Base64 文本数据..."></textarea>
            </div>

            <div class="form-group mb-3">
                <!-- Mode selection using a dropdown or individual action buttons -->
                <button type="submit" name="importMode" value="append" class="btn btn-primary">
                    追加导入
                </button>
                <button type="submit" name="importMode" value="overwrite" class="btn btn-danger"
                        onclick="return confirm('警告：直接导入(覆盖模式)将会清空之前的所有数据！确定继续吗？');">
                    覆盖导入 (清空旧数据)
                </button>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
