<Window x:Class="Rename.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Rename"
        mc:Ignorable="d"
        Title="批量文件重命名" Height="700" Width="1140"
        Icon="icon.ico"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="260" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="340" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：目标文件目录和文件 -->
            <GroupBox Grid.Column="0" Header="目标文件" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="浏览..." Width="64"
                                Margin="4,0,0,0" Click="BrowseButton_Click" />
                        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新" Width="56"
                                Margin="4,0,0,0" Click="RefreshButton_Click"
                                ToolTip="重新读取当前目录及子文件夹（F5）" />
                        <TextBlock DockPanel.Dock="Left" Text="目录:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="CurrentPathTextBox" Height="24" VerticalContentAlignment="Center"
                                 ToolTip="输入目录路径后按回车" KeyDown="CurrentPathTextBox_KeyDown" />
                    </DockPanel>

                    <DockPanel Grid.Row="1" Margin="0,0,0,4">
                        <CheckBox x:Name="IncludeSubFoldersCheckBox" DockPanel.Dock="Left" Content="包含子文件夹"
                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                  Checked="IncludeSubFolders_Changed" Unchecked="IncludeSubFolders_Changed" />
                        <TextBlock DockPanel.Dock="Left" Text="筛选:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="FilterTextBox" Width="110" Height="22" VerticalContentAlignment="Center"
                                 Text="*" ToolTip="例如 *.jpg 或 *.*" TextChanged="FilterTextBox_TextChanged" />
                    </DockPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" MinWidth="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                        </Grid.ColumnDefinitions>

                        <TreeView x:Name="FolderTree" Grid.Column="0"
                                  SelectedItemChanged="FolderTree_SelectedItemChanged" />

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

                        <ListView x:Name="SourceFileList" Grid.Column="2" SelectionMode="Extended"
                                  MouseDoubleClick="SourceFileList_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="文件名" Width="180" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="大小" Width="80" DisplayMemberBinding="{Binding SizeText}" />
                                    <GridViewColumn Header="修改时间" Width="140" DisplayMemberBinding="{Binding ModifiedText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Grid>
            </GroupBox>

            <!-- 中间：操作按钮 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                <Button x:Name="AddSelectedButton" Content="添加选中 &gt;&gt;" Width="100" Margin="0,0,0,8"
                        Click="AddSelectedButton_Click" />
                <Button x:Name="AddAllButton" Content="全部添加 &gt;&gt;" Width="100" Margin="0,0,0,8"
                        Click="AddAllButton_Click" />
                <Button x:Name="RemoveSelectedButton" Content="&lt;&lt; 移除" Width="100" Margin="0,0,0,8"
                        Click="RemoveSelectedButton_Click" />
                <Button x:Name="ClearButton" Content="清空" Width="100" Click="ClearButton_Click" />
            </StackPanel>

            <!-- 右侧：要操作的文件 -->
            <GroupBox Grid.Column="2" Header="待重命名文件（列表顺序决定编号）" Padding="4">
                <ListView x:Name="RenameList" SelectionMode="Extended">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="原文件名" Width="170" DisplayMemberBinding="{Binding FileName}" />
                            <GridViewColumn Header="新文件名" Width="170" DisplayMemberBinding="{Binding NewName}" />
                            <GridViewColumn Header="状态" Width="80" DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Header="目录" Width="200" DisplayMemberBinding="{Binding DirectoryName}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
        </Grid>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" />

        <!-- 底部：配置、进度 -->
        <GroupBox Grid.Row="2" Header="重命名配置" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Left" Text="常用规则:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="PresetComboBox" DockPanel.Dock="Left" Width="150" Height="26"
                              Margin="0,0,12,0" VerticalContentAlignment="Center"
                              ToolTip="选择常用的命名规则，自动填入命名模板"
                              SelectionChanged="PresetComboBox_SelectionChanged" />
                    <TextBlock DockPanel.Dock="Left" Text="命名模板:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="StartButton" DockPanel.Dock="Right" Content="开始" Width="90" Height="26"
                            Margin="8,0,0,0" Click="StartButton_Click" />
                    <TextBox x:Name="TemplateTextBox" Height="26" VerticalContentAlignment="Center"
                             Text="*_#####" ToolTip="例如 *_##### 或 $P_#####"
                             TextChanged="TemplateTextBox_TextChanged" />
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="扩展名:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="ExtensionCaseComboBox" DockPanel.Dock="Left" Width="110" Height="26"
                              Margin="0,0,12,0" VerticalContentAlignment="Center" SelectedIndex="0"
                              ToolTip="选择是否统一文件扩展名的大小写"
                              SelectionChanged="ExtensionCaseComboBox_SelectionChanged">
                        <ComboBoxItem Content="不改变" />
                        <ComboBoxItem Content="大写" />
                        <ComboBoxItem Content="小写" />
                    </ComboBox>
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                               Text="例如 photo.jpg → photo.JPG 或 photo.jpg" />
                </DockPanel>

                <TextBlock Grid.Row="2" x:Name="PreviewTextBlock" Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis" />

                <Expander Grid.Row="3" Header="占位符说明" Margin="0,6,0,0">
                    <StackPanel Margin="6">
                        <TextBlock TextWrapping="Wrap"
                                   Text="#  - 一个有序数字（连续 # 的个数为补零宽度，如 Image##### 的第 32 个文件为 Image00032）" />
                        <TextBlock TextWrapping="Wrap" Text="*  - 原文件名（不含扩展名）" />
                        <TextBlock TextWrapping="Wrap" Text="$P - 父文件夹名" />
                        <TextBlock TextWrapping="Wrap" Text="$Y 年   $M 月   $D 日   $H 时   $N 分   $S 秒" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="示例: $P_##### 会把文件夹 ABC 中第 32 个文件命名为 ABC_00032.jpg；$Y-$M-$D_##### 会得到 2004-09-30_00032.jpg；*_tn 会把 John.jpg 变成 John_tn.jpg。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="常用规则: 上方的“常用规则”下拉框可直接套用 原名+序号 / 序号 / 文件夹名+序号 / 日期+序号 / 原名+日期 / 原名 等预设。" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="刷新: 点击“刷新”按钮或按 F5 可重新读取当前目录的文件与子文件夹。" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="扩展名: “扩展名”下拉框可选择 不改变 / 大写 / 小写，只调整扩展名的大小写，不影响文件名主体。" />
                    </StackPanel>
                </Expander>

                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="进度:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ProgressBar x:Name="RenameProgress" Grid.Column="1" Height="18" Minimum="0" />
                </Grid>

                <TextBlock Grid.Row="5" x:Name="StatusText" Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis" Text="就绪" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>
