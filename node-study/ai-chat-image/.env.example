# OpenAI API Key，用于 Vercel AI SDK 调用对话模型
# 获取地址：https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# 可选：自定义 OpenAI 兼容接口地址（如使用代理或第三方兼容服务）
# OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：默认对话模型 ID，缺省为 deepseek-v4-flash-202605
# OPENAI_MODEL=deepseek-v4-flash-202605

# ============ 即梦图片生成（文生图 / 图生图） ============
# 方式一：火山引擎视觉智能（即梦图片生成），使用 AK/SK，接口自带 V4 签名
# 控制台：https://console.volcengine.com/iam/keymanage/
# 未设置 AK/SK 时才会回退到方式二
# JIMENG_ACCESS_KEY_ID=AKLTxxxxxxxx
# JIMENG_SECRET_ACCESS_KEY=xxxxxxxx
# 可选：临时凭证 Token
# JIMENG_SESSION_TOKEN=
# 可选：区域与接口地址，缺省 cn-north-1 / visual.volcengineapi.com
# JIMENG_REGION=cn-north-1
# JIMENG_HOST=visual.volcengineapi.com
# 可选：文生图 req_key，缺省 jimeng_high_aes_general_v21_L
# JIMENG_REQ_KEY=jimeng_high_aes_general_v21_L
# 可选：图生图 / 图片修改 req_key，缺省与文生图一致
# JIMENG_EDIT_REQ_KEY=jimeng_high_aes_general_v21_L

# 方式二：火山方舟（OpenAI 兼容 /images/generations），使用 API Key
# 控制台：https://console.volcengine.com/ark
# JIMENG_API_KEY=your-ark-api-key
# 可选：缺省 https://ark.cn-beijing.volces.com/api/v3
# JIMENG_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 可选：图片模型 ID，缺省 doubao-seedream-4-0-250828
# JIMENG_MODEL=doubao-seedream-4-0-250828
