@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
    Layout = null;
}

<style>
    body,html {
        margin: 0;
        padding: 0;
    }
    picture,img{
        width: 100%;
    }

    @@media (min-width: 1025px) {
        picture, img {
            object-fit: none;
        }
    }
</style>

<a asp-area="" asp-page="/Profile">
<picture>
    <source srcset="/img/2026-06-17_100535.avif" type="image/avif" /> 
    <source srcset="/img/2026-06-17_100535.webp" type="image/webp" />
    <img src="/img/2026-06-17_100535.png" alt="网站Logo" />
</picture>

</a>