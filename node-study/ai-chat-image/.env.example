# OpenAI API Key，用于 Vercel AI SDK 调用对话模型
# 获取地址：https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# 可选：自定义 OpenAI 兼容接口地址（如使用代理或第三方兼容服务）
# OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：默认对话模型 ID，缺省为 deepseek-v4-flash-202605
# OPENAI_MODEL=deepseek-v4-flash-202605

# ============ 即梦图片生成（文生图 / 图生图） ============
# 使用火山方舟（OpenAI 兼容 /images/generations）
# 控制台：https://console.volcengine.com/ark
# JIMENG_API_KEY=your-ark-api-key
# 可选：缺省 https://ark.cn-beijing.volces.com/api/v3
# JIMENG_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 可选：图片模型 ID，缺省 doubao-seedream-4-0-250828
# JIMENG_MODEL=doubao-seedream-4-0-250828
