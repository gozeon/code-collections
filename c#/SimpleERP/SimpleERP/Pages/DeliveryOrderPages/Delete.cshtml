@page
@model SimpleERP.Pages.DeliveryOrderPages.DeleteModel

@{
    ViewData["Title"] = "删除";
}


<h3>你确定删除该项?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">
            单号
        </dt>
        <dd class="col-sm-10">
            @Model.DeliveryOrder.Id
        </dd>

        <dt class="col-sm-2">
            总金额
        </dt>
        <dd class="col-sm-10">
            @Model.DeliveryOrder.TotalAmount.ToString("C")
        </dd>

        <dt class="col-sm-2">
            收货人
        </dt>
        <dd class="col-sm-10">
            @Model.DeliveryOrder.Consignee
        </dd>

        <dt class="col-sm-2">
            收货地址
        </dt>
        <dd class="col-sm-10">
            @Model.DeliveryOrder.Address
        </dd>

        <dt class="col-sm-2">
            发货时间
        </dt>
        <dd class="col-sm-10">
            @Model.DeliveryOrder.DeliveryTime?.ToString("d")
        </dd>

        <dt class="col-sm-2">
            创建时间
        </dt>
        <dd class="col-sm-10">
            @Model.DeliveryOrder.CreateTime
        </dd>

        <dt class="col-sm-2">
            备注
        </dt>
        <dd class="col-sm-10">
            @Model.DeliveryOrder.Remark
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="DeliveryOrder.Id" />
        <input type="submit" value="删除" class="btn btn-danger" /> |
        <a asp-page="./Index">返回列表</a>
    </form>
</div>
